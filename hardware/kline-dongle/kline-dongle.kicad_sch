  (wire (pts (xy 114.3 274.32) (xy 111.76 274.32)) (stroke (width 0) (type default)) (uuid "150cff08-735b-5165-8ac1-05f0da264340"))
  (label "XIAO_5V" (at 111.76 274.32 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "cedddf28-8ec2-5033-a740-e6b51335e442"))
  (text "TP1-TP8: BACK SIDE probe pads. U1 is the horizontal R-78HB (8.5 mm high). Fit an external XIAO antenna inside the plastic shell." (exclude_from_sim no) (at 25.4 226.06 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "14a441b1-ac4a-5a0a-bf94-91b5ad011991"))
  (text "Power: OBD pin 16 (always-on battery) -> PTC fuse -> reverse diode -> TVS -> RECOM 5 V converter." (exclude_from_sim no) (at 25.4 22.86 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "804c4d48-20b4-5c98-9239-44a2b30e8bfb"))
  (text "USB may stay connected in the car: D3 keeps USB VBUS out of the converter (Seeed's recommended 5V-pad input)." (exclude_from_sim no) (at 25.4 27.94 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "73941c0f-30c3-5c2b-8ef5-24cb46a8b1a0"))
  (text "K-line: L9637D (ISO 9141, no TX dominant timeout - LIN transceivers cut off the 200 ms 5-baud bits)." (exclude_from_sim no) (at 25.4 73.66 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "289e3ccd-dcbe-5922-894a-0ba06ea75b32"))
  (text "TX: 3.3 V -> 5 V through U3 (R3 holds TX idle; Q1/R10/R11 disable U3 until GPIO7 HIGH). RX: 5 V tolerant, 3.3 V Schmitt buffer U6 (Ioff isolation)." (exclude_from_sim no) (at 25.4 78.74 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "d3adb72b-8921-5c50-8435-6e28f154fbc9"))
  (text "ESP32 pins: GPIO4 = K TX (UART1), GPIO5 = K RX (UART1), GPIO3 = battery sense (ADC1 ch3), GPIO10 = LED; GPIO7 = TX enable (active high). GPIO6 is free." (exclude_from_sim no) (at 25.4 124.46 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "2b3fccda-1a57-5aaa-b0f7-04ba8c286802"))
  (text "Battery sense: 100k / 10k, VBAT = ADC volts x 11. Draws 0.11 mA; the 29.2 V TVS clamp reads 2.65 V." (exclude_from_sim no) (at 25.4 129.54 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "4dc04507-59c7-5f29-952e-15cb0bfeea76"))
  (sheet_instances (path "/" (page "1")))
