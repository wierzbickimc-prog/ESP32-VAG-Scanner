CONFIG_IDF_TARGET="esp32p4"
# 1 ms ticks so K-line delays aren't rounded to 10 ms.
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
# The JC8012P4A1C ships with ESP32-P4 silicon revision v1.x.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y
# The board has 16 MB of flash.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# App with embedded hero images (~3 MB) needs a bigger partition.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# UI fonts and LVGL memory from the system heap (PSRAM).
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y
